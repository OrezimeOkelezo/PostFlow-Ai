# Appwrite project configuration
# Copy this file to .env and fill in the values from your POSTFLOW AI Appwrite project.
VITE_APPWRITE_ENDPOINT=https://<REGION>.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your_appwrite_project_id

# IMPORTANT: Never put Appwrite API keys, Meta secrets or social access tokens
# in VITE_ variables. They are public in the browser bundle.
